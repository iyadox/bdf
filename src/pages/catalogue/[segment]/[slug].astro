---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import ProductSection from '@/components/catalog/ProductSection.astro';
import ProductCard from '@/components/ui/ProductCard.astro';
import VideoEmbed from '@/components/ui/VideoEmbed.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import CompareBar from '@/components/catalog/CompareBar.astro';
import { getProducts, getCategories, productUrl, quoteUrl, variantsOf, relatedTo, categoryUrl, type Product } from '@/lib/catalog';
import { badgeKind, stripHtml, truncate } from '@/lib/site';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({ params: { segment: p.segment, slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const categories = await getCategories();
const catNames = Object.fromEntries(categories.map((c) => [c.slug, c.title]));
const mainCat = categories.find((c) => c.segment === p.segment) || categories.find((c) => p.categories.includes(c.slug));
const variants = await variantsOf(p);
const related = await relatedTo(p, 4);
const url = productUrl(p);
const certs = p.filters.certifications.filter((c) => c !== 'Sans certification');
const isDoor = /porte|blindage/.test(p.segment) && p.segment !== 'blocs-portes-blindes-vitres';
const desc = p.seo?.description || truncate(stripHtml(p.summary || p.teaser || p.composition || ''), 160) || `${p.title} — Blindages de France, fabrication française sur mesure.`;
const images = [p.image, ...(p.gallery || []), p.situationImage].filter(Boolean) as string[];

const nav = [
  { id: 'fiche', label: 'Fiche', icon: 'door-closed', show: true },
  { id: 'composition', label: 'Composition', icon: 'layers', show: !!p.composition },
  { id: 'serrures', label: 'Serrures', icon: 'lock', show: !!p.locks },
  { id: 'huisserie', label: 'Huisserie', icon: 'frame', show: !!p.frame },
  { id: 'options', label: 'Options', icon: 'sliders', show: !!p.options?.groups?.length || !!p.options?.intro },
  { id: 'esthetique', label: 'Esthétique', icon: 'palette', show: !!p.finishes },
  { id: 'certifications', label: 'Certifications', icon: 'award', show: !!p.certification },
  { id: 'fermeture', label: 'Fermeture', icon: 'door-closed', show: !!p.closing },
  { id: 'usages', label: 'Usages', icon: 'building', show: !!p.usages?.items?.length },
  { id: 'caracteristiques', label: 'Caractéristiques', icon: 'list-checks', show: !!p.characteristics },
].filter((n) => n.show);
let n = 0;
const num = () => String(++n).padStart(2, '0');

const specIcon: Record<string, string> = { vantaux: 'door-closed', dimensions: 'ruler', fermeture: 'lock', certification: 'award' };
const specLabel: Record<string, string> = { vantaux: 'Vantaux', dimensions: 'Dimensions', fermeture: 'Fermeture', certification: 'Certification' };
const levelClass = (l = '') => (/max/i.test(l) ? 'lv--max' : /renf/i.test(l) ? 'lv--renf' : 'lv--std');

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.title,
  image: images.map((i) => new URL(i, Astro.site).href),
  description: desc,
  sku: p.slug,
  category: mainCat?.title,
  brand: { '@type': 'Brand', name: 'Blindages de France' },
  manufacturer: { '@id': new URL('/#organisation', Astro.site).href },
  countryOfOrigin: 'FR',
  url: new URL(url, Astro.site).href,
  ...(certs.length ? { additionalProperty: certs.map((c) => ({ '@type': 'PropertyValue', name: 'Certification', value: c })) } : {}),
};
---

<BaseLayout title={p.seo?.title || p.title} description={desc} image={p.situationImage || p.image} type="product" jsonLd={ld} bodyClass="page-product">
  <section class="phead" id="fiche">
    <div class="phead__bg" aria-hidden="true"></div>
    <div class="container">
      <Breadcrumbs items={[{ label: 'Catalogue', href: '/catalogue' }, ...(mainCat ? [{ label: mainCat.title, href: categoryUrl(mainCat) }] : []), { label: p.title }]} />
      <div class="phead__grid">
        <div class="viewer" data-viewer>
          <div class="viewer__stage product-stage" data-tilt="6">
            <div class="viewer__rings" aria-hidden="true"><i></i><i></i></div>
            {images[0] ? <img src={images[0]} alt={p.title} class="viewer__img" data-viewer-img width="460" height="620" fetchpriority="high" /> : <Icon name="door-closed" size={120} />}
            <button type="button" class="viewer__zoom" data-lightbox={images[0]} data-alt={p.title} aria-label="Agrandir l'image"><Icon name="maximize" size={18} /></button>
            <span class="viewer__tag mono">Réf. {p.slug.toUpperCase().slice(0, 28)}</span>
          </div>
          {
            images.length > 1 && (
              <div class="viewer__thumbs" role="tablist" aria-label="Images du produit">
                {images.map((im, i) => (
                  <button type="button" class:list={['thumb', { 'is-on': i === 0 }]} data-thumb={im} aria-label={`Image ${i + 1}`}>
                    <img src={im} alt="" loading="lazy" />
                  </button>
                ))}
              </div>
            )
          }
          <div class="viewer__trust">
            <span><img src="/media/editeur/fabrique-en-france.png" alt="" width="40" height="40" loading="lazy" /> Fabriqué en France</span>
            {isDoor && <span><img src="/media/editeur/garantie-10-ans.png" alt="" width="40" height="40" loading="lazy" /> Garantie 10 ans</span>}
            <span><Icon name="ruler" size={18} /> Sur mesure</span>
          </div>
        </div>

        <div class="pinfo">
          {mainCat && <a href={categoryUrl(mainCat)} class="eyebrow">{mainCat.title}</a>}
          <h1 class="pinfo__title">{p.title}</h1>
          <div class="pinfo__badges">
            {
              certs.map((c) => (
                <span class={`badge badge--${badgeKind(c)}`}>
                  <Icon name={badgeKind(c) === 'feu' ? 'flame' : badgeKind(c) === 'balles' ? 'crosshair' : 'shield'} /> {c}
                </span>
              ))
            }
            <span class="badge badge--fr"><Icon name="factory" /> Fabriqué en France</span>
          </div>
          {p.summary ? <div class="pinfo__sum prose" set:html={p.summary} /> : p.teaser && <p class="pinfo__sum">{p.teaser}</p>}

          {
            p.specs && Object.keys(p.specs).length > 0 && (
              <dl class="specs">
                {(['vantaux', 'dimensions', 'fermeture', 'certification'] as const)
                  .filter((k) => p.specs?.[k])
                  .map((k) => (
                    <div class="spec">
                      <dt>
                        <Icon name={specIcon[k]} size={16} /> {specLabel[k]}
                        {k === 'dimensions' && (
                          <span class="tip" tabindex="0" role="note" aria-label="Fabricant de blocs-portes sur mesure : pour toutes autres dimensions, nous vous proposerons une solution personnalisée.">
                            <Icon name="info" size={14} />
                          </span>
                        )}
                      </dt>
                      <dd>{p.specs?.[k]}</dd>
                    </div>
                  ))}
              </dl>
            )
          }

          {
            variants.length > 0 && (
              <div class="variants">
                <span class="mono">Existe aussi en</span>
                {variants.map((v) => (
                  <a href={productUrl(v)} class="chip">
                    <Icon name="door-closed" size={14} /> {v.filters.vantaux[0] || v.title}
                  </a>
                ))}
              </div>
            )
          }

          <div class="pcta">
            <a href="/installateurs-portes-blindees" class="pcta__btn pcta__btn--a">
              <span class="pcta__k mono"><Icon name="map-pin" size={13} /> Particuliers</span>
              <span class="pcta__t">Trouver un installateur</span>
            </a>
            <a href={quoteUrl(p)} class="pcta__btn pcta__btn--b">
              <span class="pcta__k mono"><Icon name="briefcase" size={13} /> Professionnels</span>
              <span class="pcta__t">Demander un devis</span>
            </a>
          </div>

          <div class="ptools">
            <button type="button" class="ptool fav" data-fav={p.slug} data-title={p.title} data-url={url} data-image={p.image} data-quote={p.quoteLabel || p.title} aria-pressed="false">
              <Icon name="heart" size={17} /> <span data-fav-label>Ajouter à ma sélection</span>
            </button>
            <label class="ptool">
              <input type="checkbox" class="sr-only" data-compare={p.slug} data-title={p.title} data-image={p.image} />
              <Icon name="scale" size={17} /> Comparer
            </label>
            {
              isDoor && (
                <a href={`/configurateur?modele=${p.slug}`} class="ptool">
                  <Icon name="cube" size={17} /> Configurer en 3D
                </a>
              )
            }
            <button type="button" class="ptool" data-share data-title={p.title}><Icon name="share" size={17} /> Partager</button>
            <button type="button" class="ptool" data-print><Icon name="printer" size={17} /> Imprimer</button>
          </div>

          {
            p.downloads.length > 0 && (
              <div class="pdf panel">
                <span class="pdf__ic">
                  <Icon name="file-text" size={26} />
                </span>
                <span class="pdf__txt">
                  <strong>Fiche produit PDF</strong>
                  <span>Imprimez cette fiche pour vos rendez-vous clients</span>
                </span>
                <span class="pdf__btns">
                  {p.downloads.map((d, i) => (
                    <a href={d.file} class="btn btn--sm" download target="_blank" rel="noopener">
                      <Icon name="download" /> {p.downloads.length > 1 ? `PDF ${i + 1}` : 'Télécharger'}
                    </a>
                  ))}
                </span>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  {
    nav.length > 2 && (
      <nav class="ptabs" aria-label="Sections de la fiche" data-ptabs>
        <div class="container ptabs__in">
          {nav.map((t) => (
            <a href={`#${t.id}`} data-tab={t.id}>
              <Icon name={t.icon} size={15} /> {t.label}
            </a>
          ))}
        </div>
      </nav>
    )
  }

  {
    p.composition && (
      <ProductSection id="composition" icon="layers" title="Composition" sub="Structure et matériaux" num={num()} tone="panel">
        <div class="comp">
          <div class="prose comp__txt" set:html={p.composition} />
          {isDoor && (
            <a href="/#anatomy-title" class="comp__promo panel" data-spot>
              <Icon name="layers" size={30} />
              <strong>Anatomie d'une porte blindée</strong>
              <span class="muted">Découvrez en 3D chaque couche : acier, omégas, isolation, serrure, huisserie…</span>
              <span class="link-arrow">
                Voir la vue éclatée <Icon name="arrow-right" />
              </span>
            </a>
          )}
        </div>
      </ProductSection>
    )
  }

  {
    p.locks && (
      <ProductSection id="serrures" icon="lock" title="Sécurité & serrures" sub="Systèmes de fermeture certifiés haute sécurité" num={num()}>
        {p.locks.intro && <p class="intro">{p.locks.intro}</p>}
        {p.locks.table && p.locks.table.length > 0 && (
          <div class="tablewrap">
            <table class="ltable">
              <thead>
                <tr>
                  {(p.locks.tableHeads || ['Marque', 'Modèle', 'Points', 'Certification', 'Niveau']).map((h) => (
                    <th>{h.replace('Modele', 'Modèle')}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {p.locks.table.map((r) => (
                  <tr>
                    <td>
                      <strong>{r.brand || '—'}</strong>
                    </td>
                    <td>{r.model || '—'}</td>
                    <td class="mono">{r.points || '—'}</td>
                    <td class="mono">{r.certification || '—'}</td>
                    <td>{r.level ? <span class={`lv ${levelClass(r.level)}`}>{r.level}</span> : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {p.locks.html && <div class="prose" set:html={p.locks.html} />}
        {p.locks.extras && (
          <div class="extras">
            {p.locks.extras.map((x) => (
              <div class="extra panel">
                <p class="extra__t">
                  <Icon name={x.icon || 'key'} /> {x.title}
                </p>
                <div class="prose" set:html={x.html} />
              </div>
            ))}
          </div>
        )}
        {p.locks.more?.map((m) => (
          <div class="more">
            {m.title && <p class="h4">{m.title}</p>}
            <div class="prose" set:html={m.html} />
          </div>
        ))}
      </ProductSection>
    )
  }

  {
    p.frame && (
      <ProductSection id="huisserie" icon="frame" title="Huisserie & structure" sub="Solutions d'installation adaptées à votre projet" num={num()} tone="panel">
        {p.frame.intro && <p class="intro" set:html={p.frame.intro.replace(/\n\n/g, '<br />')} />}
        {p.frame.html && <div class="prose" set:html={p.frame.html} />}
        {p.frame.cards && (
          <div class="cards">
            {p.frame.cards.map((c) => (
              <div class="icard" data-tilt="5">
                <span class="icon-box">
                  <Icon name={c.icon || 'frame'} />
                </span>
                <p class="h4">{c.title}</p>
                {c.description && <p class="muted">{c.description}</p>}
              </div>
            ))}
          </div>
        )}
      </ProductSection>
    )
  }

  {
    p.options && (p.options.groups?.length || p.options.intro) && (
      <ProductSection id="options" icon="sliders" title="Options & personnalisation" sub="Équipements complémentaires" num={num()}>
        {p.options.intro && <p class="intro">{p.options.intro}</p>}
        {p.options.html && <div class="prose" set:html={p.options.html} />}
        {p.options.groups && (
          <div class="ogroups">
            {p.options.groups.map((g) => (
              <div class="ogroup">
                <p class="ogroup__t">
                  <Icon name={g.icon || 'plus-circle'} /> {g.title.replace('De serie', 'De série')}
                </p>
                <ul>
                  {g.items.map((it) => (
                    <li>
                      {it.picto && (
                        <button type="button" class="opicto" data-lightbox={it.picto} data-alt={it.label} aria-label={`Agrandir : ${it.label}`}>
                          <img src={it.picto} alt="" loading="lazy" width="56" height="56" />
                        </button>
                      )}
                      <span>{it.label}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
        {p.options.note && <div class="prose note" set:html={p.options.note} />}
      </ProductSection>
    )
  }

  {
    p.finishes && (
      <ProductSection id="esthetique" icon="palette" title="Esthétique & finitions" sub="Personnalisez l'apparence de votre produit" num={num()} tone="panel">
        <div class="finish">
          {p.finishes.standard && (
            <div class="finish__std">
              <p class="mono finish__k">
                <Icon name="check-circle" size={14} /> De série
              </p>
              {p.finishes.standard.map((s) => (
                <div class="finish__card finish__card--std">
                  <Icon name="spray" size={22} /> {s}
                </div>
              ))}
            </div>
          )}
          {p.finishes.options && (
            <div class="finish__opts">
              <p class="mono finish__k">
                <Icon name="palette" size={14} /> En option
              </p>
              <div class="finish__grid">
                {p.finishes.options.map((o) => (
                  <div class="finish__card" data-tilt="6">
                    <Icon name={o.icon || 'palette'} size={24} />
                    <strong>{o.title}</strong>
                    {o.description && <span class="muted">{o.description}</span>}
                  </div>
                ))}
              </div>
            </div>
          )}
          {p.finishes.html && <div class="prose" set:html={p.finishes.html} />}
        </div>
        {isDoor && (
          <a href={`/configurateur?modele=${p.slug}`} class="cfgpromo" data-spot>
            <span class="cfgpromo__swatches" aria-hidden="true">
              <i style="--c:#383e42" />
              <i style="--c:#f1f1ee" />
              <i style="--c:#6b1c23" />
              <i style="--c:#0e518d" />
              <i style="--c:#b07c45" />
            </span>
            <span>
              <strong>Visualisez votre couleur en 3D</strong>
              <span class="muted">Nuancier RAL, finitions texturées, tons bois, bi-couleur intérieur/extérieur.</span>
            </span>
            <span class="btn btn--sm">
              Configurateur <Icon name="arrow-right" />
            </span>
          </a>
        )}
      </ProductSection>
    )
  }

  {
    p.certification && (
      <ProductSection id="certifications" icon="award" title="Certifications & performances" sub="Qualité certifiée par des laboratoires indépendants" num={num()} tone="certif">
        <div class="cert">
          <div class="cert__head">
            <div class="cert__badges">
              {p.certification.badges.map((b) => (
                <span class={`cbadge cbadge--${b.type}`}>
                  <Icon name={b.type === 'feu' ? 'flame' : b.type === 'balles' ? 'crosshair' : b.type === 'perf' ? 'activity' : 'shield'} /> {b.label}
                </span>
              ))}
            </div>
            {p.certification.labs && <p class="muted">{p.certification.labs}</p>}
          </div>
          <div class="cert__grid">
            {p.certification.logos.length > 0 && (
              <div class="cert__logos">
                {p.certification.logos.map((l) => (
                  <figure>
                    <img src={l.image} alt={l.alt || l.caption || ''} loading="lazy" />
                    {l.caption && <figcaption>{l.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            )}
            <div class="cert__body">
              {p.certification.description && <div class="prose" set:html={p.certification.description} />}
              {p.certification.norms && <div class="prose" set:html={p.certification.norms} />}
              {p.certification.video && (
                <div class="cert__video">
                  <p class="mono cert__vt">
                    <Icon name="play-circle" size={16} /> {p.certification.videoTitle || 'Vidéo de test en laboratoire'}
                  </p>
                  <VideoEmbed id={p.certification.video} title={`${p.title} — test en laboratoire`} />
                </div>
              )}
              {p.certification.links && (
                <ul class="cert__links">
                  {p.certification.links.map((l) => (
                    <li>
                      <Icon name="check" size={15} /> {l}
                    </li>
                  ))}
                </ul>
              )}
              <div class="btn-row">
                <a href="/certifications/anti-effraction" class="link-arrow">
                  Certification A2P <Icon name="arrow-right" />
                </a>
                <a href="/certification-porte-blindee/coupe-feu" class="link-arrow">
                  Coupe-feu <Icon name="arrow-right" />
                </a>
                <a href="/certification-porte-blindee/pare-balles" class="link-arrow">
                  Pare-balles <Icon name="arrow-right" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </ProductSection>
    )
  }

  {
    p.closing && (
      <ProductSection id="fermeture" icon="door-closed" title="Système de fermeture" sub="Mécanismes de verrouillage" num={num()} tone="panel">
        {p.closing.intro && <p class="intro">{p.closing.intro}</p>}
        {p.closing.html && <div class="prose" set:html={p.closing.html} />}
        {p.closing.cards && (
          <div class="cards">
            {p.closing.cards.map((c) => (
              <div class="icard">
                <span class="icon-box">
                  <Icon name={c.icon || 'door-closed'} />
                </span>
                <p class="h4">{c.title}</p>
                {c.description && <p class="muted">{c.description}</p>}
              </div>
            ))}
          </div>
        )}
      </ProductSection>
    )
  }

  {
    p.usages && p.usages.items.length > 0 && (
      <ProductSection id="usages" icon="building" title="Usages & applications" sub="Secteurs d'activité et applications" num={num()}>
        {p.usages.intro && <p class="intro">{p.usages.intro}</p>}
        <ul class="usages">
          {p.usages.items.map((u) => (
            <li class="usage" data-tilt="8">
              <span class="usage__ic">
                <Icon name={u.icon || 'building'} size={26} />
              </span>
              <span>{u.title.replace('Hopitaux', 'Hôpitaux').replace('Supermarches', 'Supermarchés')}</span>
            </li>
          ))}
        </ul>
      </ProductSection>
    )
  }

  {
    p.characteristics && (
      <ProductSection id="caracteristiques" icon="list-checks" title="Caractéristiques" sub="Détails techniques du produit" num={num()} tone="panel">
        <div class="prose caract" set:html={p.characteristics.html} />
      </ProductSection>
    )
  }

  {
    related.length > 0 && (
      <section class="section section--tight related">
        <div class="container">
          <div class="related__head">
            <div>
              <p class="eyebrow">Vous aimerez aussi</p>
              <h2 class="h2">Produits similaires</h2>
            </div>
            <a href={mainCat ? categoryUrl(mainCat) : '/catalogue'} class="btn btn--ghost">
              Toute la gamme <Icon name="arrow-right" />
            </a>
          </div>
          <div class="related__grid">
            {related.map((r) => (
              <ProductCard p={r} catNames={catNames} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand title={`Intéressé par ${p.title} ?`} text="Nos équipes vous répondent sous 24 h. Particuliers : trouvez l'installateur agréé le plus proche. Professionnels : demandez vos tarifs." />

  <CompareBar />
</BaseLayout>

<script>
  import '@/scripts/pages/product';
</script>

<style>
  .phead {
    position: relative;
    padding: 2rem 0 clamp(2.5rem, 2rem + 3vw, 4.5rem);
    overflow: hidden;
  }
  .phead__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(50% 60% at 25% 45%, rgba(46, 104, 148, 0.3), transparent 70%),
      radial-gradient(40% 50% at 90% 10%, rgba(255, 102, 34, 0.1), transparent 70%);
  }
  .phead__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(1.5rem, 4vw, 4.5rem);
    margin-top: 1.6rem;
    align-items: start;
  }
  .viewer {
    position: sticky;
    top: calc(var(--header-h) + 1rem);
    display: grid;
    gap: 0.9rem;
  }
  .viewer__stage {
    position: relative;
    aspect-ratio: 1 / 1.05;
    border-radius: 22px;
    border: 1px solid var(--line-2);
    transform: perspective(1200px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.6s var(--ease);
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.5);
  }
  :global(.viewer__stage.is-tilting) {
    transition: none;
  }
  .viewer__img {
    position: relative;
    z-index: 1;
    height: 86%;
