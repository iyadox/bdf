---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---

<BaseLayout title="Page introuvable" noindex>
  <section class="nf">
    <div class="nf__door" aria-hidden="true">
      <div class="nf__frame">
        <div class="nf__leaf">
          <span class="nf__lock"></span>
          <span class="nf__handle"></span>
          {Array.from({ length: 5 }).map((_, i) => <span class="nf__bolt" style={`--i:${i}`} />)}
        </div>
      </div>
      <div class="nf__glow"></div>
    </div>
    <div class="nf__txt">
      <p class="eyebrow">Erreur 404 · Accès verrouillé</p>
      <h1 class="h1">Cette porte <span class="grad-accent">reste fermée</span></h1>
      <p class="lead">La page demandée n'existe pas ou a été déplacée. Même nos portes blindées ne s'ouvrent pas sans la bonne clé…</p>
      <div class="btn-row">
        <a href="/" class="btn"><Icon name="home" /> Retour à l'accueil</a>
        <a href="/catalogue" class="btn btn--ghost"><Icon name="grid" /> Catalogue</a>
        <button type="button" class="btn btn--ghost" data-open-search><Icon name="search" /> Rechercher</button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: calc(100vh - var(--header-h) - 40px);
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    align-items: center;
    gap: 3rem;
    width: min(100% - 2 * var(--gutter), 1200px);
    margin-inline: auto;
    padding-block: 3rem;
  }
  .nf__txt {
    display: grid;
    gap: 1.2rem;
  }
  .nf__txt .lead {
    margin: 0;
  }
  .nf__door {
    position: relative;
    display: grid;
    place-items: center;
    perspective: 1000px;
  }
  .nf__frame {
    position: relative;
    width: 230px;
    height: 400px;
    padding: 12px;
    background: linear-gradient(180deg, #1b2129, #0d1117);
    border: 2px solid var(--accent);
    box-shadow:
      0 0 40px rgba(74, 115, 150, 0.54),
      inset 0 0 20px rgba(0, 0, 0, 0.8);
    transform: rotateY(-18deg);
    animation: shake 5s ease-in-out infinite;
  }
  @keyframes shake {
    0%,
    86%,
    100% {
      transform: rotateY(-18deg);
    }
    88% {
      transform: rotateY(-18deg) translateX(-4px);
    }
    90% {
      transform: rotateY(-18deg) translateX(4px);
    }
    92% {
      transform: rotateY(-18deg) translateX(-3px);
    }
  }
  .nf__leaf {
    position: relative;
    height: 100%;
    background:
      repeating-linear-gradient(180deg, transparent 0 60px, rgba(0, 0, 0, 0.25) 60px 62px),
      linear-gradient(135deg, #3a4550, #242c35);
  }
  .nf__handle {
    position: absolute;
    right: 20px;
    top: 48%;
    width: 42px;
    height: 8px;
    border-radius: 4px;
    background: linear-gradient(180deg, #eef3f7, #9aa4ad);
  }
  .nf__lock {
    position: absolute;
    right: 34px;
    top: 55%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #cfd6dc;
  }
  .nf__bolt {
    position: absolute;
    right: -12px;
    top: calc(12% + var(--i) * 19%);
    width: 16px;
    height: 7px;
    border-radius: 3px;
    background: #4a7396;
    box-shadow: 0 0 12px var(--accent);
  }
  .nf__glow {
    position: absolute;
    bottom: -40px;
    width: 360px;
    height: 80px;
    background: radial-gradient(closest-side, rgba(74, 115, 150, 0.47), transparent);
  }
  @media (max-width: 860px) {
    .nf {
      grid-template-columns: minmax(0, 1fr);
    }
    .nf__frame {
      width: 160px;
      height: 280px;
    }
  }
</style>
