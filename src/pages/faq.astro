---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import faq from '@/data/faq.json';
import { miniMd, stripHtml, fold } from '@/lib/site';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.groups.flatMap((g) => g.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: stripHtml(miniMd(i.a)) } }))),
};
---

<BaseLayout title="Questions fréquentes" description="Tout savoir sur les portes blindées Blindages de France : certifications A2P et coupe-feu, sur mesure, finitions, installation, garantie, délais, espace pro." jsonLd={ld}>
  <PageHero title="Questions" accent="fréquentes" eyebrow="Tout savoir sur la porte blindée" lead="Les réponses à vos questions sur nos portes, nos certifications, l'installation et nos services." crumbs={[{ label: 'FAQ' }]}>
    <label class="fsearch" data-reveal style="--d:.24s">
      <Icon name="search" />
      <input type="search" placeholder="Rechercher une question…" data-faq-q aria-label="Rechercher dans la FAQ" />
    </label>
  </PageHero>
  <section class="section section--tight">
    <div class="container faq">
      <nav class="faq__nav" aria-label="Thèmes">
        {
          faq.groups.map((g, i) => (
            <a href={`#g${i}`} class="chip">
              <Icon name={g.icon} size={15} /> {g.title}
            </a>
          ))
        }
      </nav>
      <div class="faq__list">
        {
          faq.groups.map((g, gi) => (
            <div class="faq__group" id={`g${gi}`}>
              <h2 class="h3 faq__gt">
                <span class="icon-box">
                  <Icon name={g.icon} />
                </span>
                {g.title}
              </h2>
              {g.items.map((it) => (
                <details class="qa" data-faq-item data-text={fold(it.q + ' ' + it.a)}>
                  <summary>
                    <span>{it.q}</span>
                    <span class="qa__ic" aria-hidden="true">
                      <Icon name="plus" size={18} />
                    </span>
                  </summary>
                  <div class="qa__a prose" set:html={`<p>${miniMd(it.a)}</p>`} />
                </details>
              ))}
            </div>
          ))
        }
        <p class="faq__none muted" data-faq-none hidden>Aucune question ne correspond. <a href="/nous-contacter">Posez-nous la vôtre</a>.</p>
      </div>
    </div>
  </section>
  <CtaBand title="Vous n'avez pas trouvé votre réponse ?" text="Notre équipe est à votre écoute du lundi au vendredi, de 8h00 à 18h30." />
</BaseLayout>

<script>
  import { fold } from '@/scripts/ui/dom';
  const q = document.querySelector<HTMLInputElement>('[data-faq-q]')!;
  const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]')];
  const none = document.querySelector<HTMLElement>('[data-faq-none]')!;
  q.addEventListener('input', () => {
    const t = fold(q.value.trim()).split(/\s+/).filter(Boolean);
    let n = 0;
    items.forEach((it) => {
      const ok = t.every((w) => (it.dataset.text || '').includes(w));
      it.hidden = !ok;
      it.open = ok && t.length > 0;
      if (ok) n++;
    });
    document.querySelectorAll<HTMLElement>('.faq__group').forEach((g) => (g.hidden = !g.querySelector('[data-faq-item]:not([hidden])')));
    none.hidden = n > 0;
  });
</script>

<style>
  .fsearch {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    max-width: 560px;
    padding: 0 1rem;
    border: 1px solid var(--line-2);
    border-radius: 14px;
    background: rgba(4, 12, 24, 0.7);
    color: var(--accent);
  }
  .fsearch:focus-within {
    border-color: var(--accent);
  }
  .fsearch input {
    flex: 1;
    height: 54px;
    background: none;
    border: 0;
    outline: none;
    color: var(--text);
    font-size: 1rem;
  }
  .faq {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 3rem;
    align-items: start;
  }
  .faq__nav {
    position: sticky;
    top: calc(var(--header-h) + 1rem);
    display: grid;
    gap: 0.5rem;
  }
  .faq__list {
    display: grid;
    gap: 2.4rem;
  }
  .faq__group {
    display: grid;
    gap: 0.7rem;
    scroll-margin-top: calc(var(--header-h) + 20px);
  }
  .faq__gt {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 0.6rem;
  }
  .qa {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(10, 25, 41, 0.55);
    transition: border-color 0.3s;
  }
  .qa[open] {
    border-color: rgba(74, 115, 150, 0.61);
  }
  .qa summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa__ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    color: var(--accent);
    transition: transform 0.35s var(--ease);
  }
  .qa[open] .qa__ic {
    transform: rotate(45deg);
    background: rgba(74, 115, 150, 0.2);
  }
  .qa__a {
    padding: 0 1.3rem 1.2rem;
  }
  .faq__none a {
    color: var(--accent-2);
    text-decoration: underline;
  }
  @media (max-width: 900px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
    }
    .faq__nav {
      position: static;
      display: flex;
      flex-wrap: wrap;
    }
  }
</style>
