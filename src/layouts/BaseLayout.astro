---
import '@/styles/global.css';
import Seo from '@/components/layout/Seo.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import QuickDock from '@/components/layout/QuickDock.astro';
import SearchPalette from '@/components/layout/SearchPalette.astro';
import CookieBanner from '@/components/layout/CookieBanner.astro';
import { settings } from '@/lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
  hideFooter?: boolean;
}
const { bodyClass = '', hideFooter = false, ...seo } = Astro.props;
const runtime = {
  hours: settings.hours.days,
  analytics: settings.analytics,
  features: settings.features,
};
---

<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#03070e" />
    <meta name="format-detection" content="telephone=no" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        d.classList.add('js');
        try {
          if (localStorage.getItem('bdf-lite') === '1') d.classList.add('lite');
        } catch (e) {}
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('reduced');
      })();
    </script>
    <Seo {...seo} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body class={bodyClass} id="top">
    <a class="skip-link" href="#main">Aller au contenu principal</a>
    <div class="page-bg" aria-hidden="true"></div>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!hideFooter && <Footer />}
    <QuickDock />
    <SearchPalette />
    <CookieBanner />
    <div class="toasts" data-toasts aria-live="polite"></div>
    <script type="application/json" id="bdf-runtime" set:html={JSON.stringify(runtime)} />
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>

<style is:global>
  .toasts {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    translate: -50% 0;
    z-index: 90;
    display: grid;
    gap: 0.5rem;
    pointer-events: none;
  }
  .toast {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.8rem 1.1rem;
    font-size: 0.9rem;
    background: rgba(6, 16, 30, 0.96);
    border: 1px solid rgba(255, 102, 34, 0.5);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    animation: toast 3.2s var(--ease) forwards;
    pointer-events: auto;
  }
  .toast a {
    color: var(--orange-2);
    font-weight: 600;
    text-decoration: underline;
  }
  @keyframes toast {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    10%,
    85% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @media (max-width: 760px) {
    .toasts {
      bottom: calc(80px + env(safe-area-inset-bottom));
    }
  }
</style>
