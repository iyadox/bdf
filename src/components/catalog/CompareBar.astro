---
import Icon from '@/components/Icon.astro';
---
<div class="cmpbar" data-cmpbar hidden>
  <div class="container cmpbar__in">
    <p class="cmpbar__t"><Icon name="scale" /> <span><strong data-cmp-n>0</strong>/3 à comparer</span></p>
    <ul class="cmpbar__list" data-cmp-list></ul>
    <div class="cmpbar__btns">
      <button type="button" class="btn btn--ghost btn--sm" data-cmp-clear>Vider</button>
      <a href="/comparateur" class="btn btn--sm" data-cmp-go>Comparer <Icon name="arrow-right" /></a>
    </div>
  </div>
</div>

<style>
  .cmpbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 42;
    background: rgba(4, 12, 24, 0.94);
    backdrop-filter: blur(16px);
    border-top: 1px solid rgba(74, 115, 150, 0.45);
    box-shadow: 0 -20px 60px rgba(0, 0, 0, 0.4);
    animation: up 0.4s var(--ease);
  }
  @keyframes up {
    from {
      transform: translateY(100%);
    }
  }
  .cmpbar__in {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    min-height: 74px;
    padding-right: 4.5rem;
  }
  .cmpbar__t {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.88rem;
    color: #e8eef4;
    white-space: nowrap;
  }
  .cmpbar__list {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    flex: 1;
    overflow-x: auto;
  }
  .cmpbar__list :global(li) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.5rem 0.3rem 0.3rem;
    border: 1px solid var(--line-2);
    border-radius: 10px;
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .cmpbar__list :global(img) {
    width: 34px;
    height: 34px;
    object-fit: contain;
    background: #e9f0f6;
    border-radius: 6px;
  }
  .cmpbar__list :global(button) {
    color: var(--muted);
  }
  .cmpbar__btns {
    display: flex;
    gap: 0.5rem;
  }

  :global(.is-disabled) {
    opacity: 0.55;
  }
  @media (max-width: 560px) {
    .cmpbar__in {
      flex-wrap: wrap;
      padding: 0.7rem 0 calc(0.7rem + 70px);
      gap: 0.6rem;
    }
    .cmpbar__list {
      order: 3;
      width: 100%;
    }
  }
</style>
