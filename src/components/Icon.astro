---
import { iconPaths } from '@/lib/icons';
interface Props {
  name?: string | null;
  size?: number;
  class?: string;
  label?: string;
  stroke?: number;
}
const { name, size = 20, class: cls = '', label, stroke = 1.75 } = Astro.props;
---
<svg
  class:list={['icon', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={iconPaths(name)}
/>
