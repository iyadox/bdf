---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import VideoEmbed from '@/components/ui/VideoEmbed.astro';
import ProductCard from '@/components/ui/ProductCard.astro';
import HexMedal from './HexMedal.astro';
import Gauge from './Gauge.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import CompareBar from '@/components/catalog/CompareBar.astro';
import certs from '@/data/certifications.json';
import { getProducts, getCategories } from '@/lib/catalog';

interface Props {
  id: 'anti-effraction' | 'coupe-feu' | 'pare-balles';
}
const c = certs.pages[Astro.props.id];
const [all, categories] = await Promise.all([getProducts(), getCategories()]);
const catNames = Object.fromEntries(categories.map((x) => [x.slug, x.title]));
const products = all.filter((p) => p.filters.certifications.some((f) => c.filter.includes(f)));
const others = Object.values(certs.pages).filter((x) => x.slug !== c.slug);
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.levels.map((l) => ({
    '@type': 'Question',
    name: `Que garantit le niveau ${l.code} ?`,
    acceptedAnswer: { '@type': 'Answer', text: `${l.name} — ${l.value} ${l.unit}. ${l.text}` },
  })),
};
---

<BaseLayout title={c.title} description={`${c.title} des portes blindées Blindages de France : ${c.lead}`} jsonLd={faq}>
  <header class="chero" style={`--cc:${c.color}`}>
    <div class="chero__bg" aria-hidden="true"></div>
    <div class="container">
      <Breadcrumbs items={[{ label: 'Nos certifications', href: '/certification-porte-blindee' }, { label: c.short }]} />
      <div class="chero__grid">
        <div class="chero__txt">
          <p class="eyebrow" data-reveal>{c.norm}</p>
          <h1 class="h1" data-reveal style="--d:.08s">{c.title.split(' ').map((w) => (w.includes('-') ? <span class="nowrap">{w} </span> : `${w} `))}</h1>
          <p class="lead" data-reveal style="--d:.16s">{c.lead}</p>
          <div class="btn-row" data-reveal style="--d:.24s">
            <a href="#produits" class="btn">Voir les produits certifiés <Icon name="arrow-down" /></a>
            <a href="#video" class="btn btn--ghost"><Icon name="play-circle" /> Le test en vidéo</a>
          </div>
          <nav class="chero__others" aria-label="Autres certifications" data-reveal style="--d:.3s">
            {
              others.map((o) => (
                <a href={o.path} class="chip">
                  <Icon name={o.icon} size={15} /> {o.short}
                </a>
              ))
            }
            <a href="/certification-porte-blindee" class="chip"><Icon name="badge-check" size={15} /> Vue d'ensemble</a>
          </nav>
        </div>
        <div class="chero__medal" data-reveal="scale" style="--d:.2s">
          <HexMedal logo={c.labLogo} alt={c.lab} color={c.color} label={`Certifié ${c.lab}`} />
        </div>
      </div>
    </div>
  </header>

  <section class="section" id="video">
    <div class="container">
      <p class="eyebrow" data-reveal>Voir nos tests en action</p>
      <h2 class="h2 vtitle" data-reveal style="--d:.08s">{c.videoTitle}</h2>
      <div class="vgrid">
        <div data-reveal="left"><VideoEmbed id={c.video} title={c.videoTitle} /></div>
        <div class="tests panel panel--pad" data-reveal="right">
          <h3 class="h3">{c.testsTitle}</h3>
          <p class="muted">{c.testsText}</p>
          <ol class="tests__list">
            {
              c.tests.map((t, i) => (
                <li style={`--d:${i * 0.08}s`}>
                  <span class="tests__n mono">{String(i + 1).padStart(2, '0')}</span>
                  {t}
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="section levels" style={`--cc:${c.color}`}>
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow eyebrow--center" data-reveal>Nos {c.levels.length} niveaux de protection</p>
        <h2 class="h2" data-reveal style="--d:.08s">{c.levelsTitle}</h2>
        <p class="lead" data-reveal style="--d:.16s">{c.levelsText}</p>
      </div>
      <div class="levels__grid" style={`--n:${c.levels.length}`}>
        {
          c.levels.map((l, i) => (
            <article class="level" data-reveal="tilt" style={`--d:${i * 0.1}s`}>
              <div class="level__top">
                <span class="level__code">{l.code}</span>
                <Gauge value={l.value} unit={l.unit} pct={l.gauge} color={c.color} />
              </div>
              <h3 class="h4">{l.name}</h3>
              <p>{l.text}</p>
              <p class="level__tag mono">{l.tag}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Vos garanties</p>
        <h2 class="h2" data-reveal style="--d:.08s">{c.whyTitle}</h2>
      </div>
      <div class="why">
        {
          c.why.map((w, i) => (
            <div class="why__card panel spot" data-reveal style={`--d:${i * 0.08}s`} data-spot>
              <span class="icon-box">
                <Icon name={w.icon} />
              </span>
              <h3 class="h4">{w.title}</h3>
              <p class="muted">{w.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight" id="produits">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Notre gamme certifiée</p>
        <h2 class="h2" data-reveal style="--d:.08s">{c.productsTitle}</h2>
        <p class="lead" data-reveal style="--d:.16s">{c.productsText}</p>
      </div>
      <div class="pgrid">
        {products.map((p) => <ProductCard p={p} catNames={catNames} />)}
      </div>
      <p class="pgrid__more">
        <a href={`/catalogue?${c.filter.map((f) => `certification=${encodeURIComponent(f).replace(/%20/g, '+')}`).join('&')}`} class="link-arrow">Filtrer le catalogue <Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>

  <CtaBand title={c.ctaTitle} text={c.ctaText} />
  <CompareBar />
</BaseLayout>

<script>
  import { initCompare } from '@/scripts/ui/compare';
  initCompare();
</script>

<style>
  .chero {
    position: relative;
    padding: 2rem 0 calc(var(--section) * 0.6);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .chero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(40% 60% at 78% 50%, color-mix(in srgb, var(--cc) 22%, transparent), transparent 70%),
      radial-gradient(50% 60% at 10% 0%, rgba(46, 104, 148, 0.25), transparent 70%);
  }
  .chero__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: center;
    margin-top: 2rem;
  }
  .chero__txt {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.2rem;
  }
  .nowrap {
    white-space: nowrap;
  }
  .chero__txt .lead {
    margin: 0;
  }
  .chero__others {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chero__medal {
    display: grid;
    place-items: center;
  }
  .vtitle {
    margin: 0.8rem 0 2rem;
    font-size: var(--fs-xl);
  }
  .vgrid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  .tests {
    display: grid;
    gap: 1rem;
  }
  .tests p {
    margin: 0;
  }
  .tests__list {
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }
  .tests__list li {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    padding: 0.7rem 0.9rem;
    border-radius: 10px;
    background: rgba(3, 8, 16, 0.5);
    border: 1px solid var(--line);
    font-size: 0.92rem;
  }
  .tests__n {
    color: var(--accent);
    font-size: 0.72rem;
  }
  .levels {
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--cc) 6%, transparent), transparent);
  }
  .levels__grid {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 1.2rem;
    perspective: 1200px;
  }
  .level {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding: 1.6rem;
    border-radius: 18px;
    border: 1px solid var(--line-2);
    background: linear-gradient(165deg, rgba(21, 46, 96, 0.65), rgba(5, 13, 25, 0.85));
    transition:
      border-color 0.3s,
      transform 0.5s var(--ease);
  }
  .level:hover {
    border-color: color-mix(in srgb, var(--cc) 60%, transparent);
    transform: translateY(-6px);
  }
  .level__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .level__code {
    font-family: var(--f-display);
    font-size: 1.6rem;
    color: var(--cc);
    text-shadow: 0 0 24px color-mix(in srgb, var(--cc) 60%, transparent);
  }
  .level p {
    margin: 0;
    color: var(--text-2);
    font-size: 0.92rem;
  }
  .level__tag {
    font-size: 0.68rem !important;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted) !important;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
  }
  .why {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 1rem;
  }
  .why__card {
    position: relative;
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding: 1.6rem;
    overflow: hidden;
  }
  .why__card p {
    margin: 0;
    font-size: 0.92rem;
  }
  .pgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.1rem;
  }
  .pgrid__more {
    margin-top: 1.4rem;
  }
  @media (max-width: 1000px) {
    .chero__grid,
    .vgrid {
      grid-template-columns: minmax(0, 1fr);
    }
    .levels__grid {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    }
    .chero__medal {
      order: -1;
    }
  }
</style>
