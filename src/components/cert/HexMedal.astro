---
interface Props {
  logo: string;
  alt: string;
  color?: string;
  label?: string;
}
const { logo, alt, color = '#ff6622', label } = Astro.props;
---

<div class="medal" style={`--mc:${color}`} data-tilt="14">
  <div class="medal__orbit medal__orbit--a" aria-hidden="true"></div>
  <div class="medal__orbit medal__orbit--b" aria-hidden="true"></div>
  <div class="medal__hex">
    <div class="medal__face">
      <img src={logo} alt={alt} width="220" height="160" />
    </div>
    <div class="medal__holo" aria-hidden="true"></div>
  </div>
  {label && <span class="medal__label mono">{label}</span>}
</div>

<style>
  .medal {
    position: relative;
    width: min(340px, 70vw);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.6s var(--ease);
    animation: float 6s ease-in-out infinite;
  }
  :global(.medal.is-tilting) {
    transition: none;
  }
  .medal__orbit {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--mc) 55%, transparent);
    animation: spin 26s linear infinite;
  }
  .medal__orbit--b {
    inset: 13%;
    border: 1px solid rgba(148, 178, 212, 0.2);
    border-top-color: var(--mc);
    animation-duration: 9s;
    animation-direction: reverse;
  }
  .medal__hex {
    position: relative;
    width: 66%;
    aspect-ratio: 1 / 1.1547;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: linear-gradient(160deg, color-mix(in srgb, var(--mc) 70%, #fff), color-mix(in srgb, var(--mc) 40%, #001c3c));
    padding: 3px;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.5));
  }
  .medal__face {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: radial-gradient(90% 80% at 50% 30%, #ffffff, #dfe8f1);
    padding: 18%;
  }
  .medal__face img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  .medal__holo {
    position: absolute;
    inset: 0;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.65) 45%, transparent 60%);
    background-size: 250% 100%;
    animation: shimmer 4.5s var(--ease-io) infinite;
    mix-blend-mode: overlay;
  }
  .medal__label {
    position: absolute;
    bottom: 2%;
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--mc);
    background: rgba(3, 8, 16, 0.8);
    padding: 0.35rem 0.8rem;
    border-radius: 99px;
    border: 1px solid color-mix(in srgb, var(--mc) 50%, transparent);
  }
</style>
