---
import Icon from '@/components/Icon.astro';
const steps = [
  { id: 'front', icon: 'layers', k: 'Parement', title: 'Acier 15/10e électrozingué', text: 'Deux faces en tôle d’acier de 15/10e électrozinguée : la première barrière contre la découpe et l’arrachement.' },
  { id: 'omegas', icon: 'bars', k: 'Structure', title: '5 omégas raidisseurs', text: 'Des profils en oméga soudés rigidifient le vantail et résistent aux tentatives de pesée et d’enfoncement.' },
  { id: 'wool', icon: 'box', k: 'Isolation', title: 'Laine de roche', text: 'Le cœur isolant apporte le confort thermique et acoustique — jusqu’à Ud = 2,8 et 39 dB sur la SIGNATURE.' },
  { id: 'lock', icon: 'lock', k: 'Verrouillage', title: 'Serrure multipoints A2P', text: 'Jusqu’à 7 points de fermeture, cylindre haute sécurité et serrures certifiées jusqu’à A2P*** (Vachette, Picard, AM Locks…).' },
  { id: 'hinges', icon: 'rotate', k: 'Rotation', title: 'Paumelles à billes 140 mm', text: 'Paumelles soudées à billes et renforts de paumelles, avec anti-dégondage par tenon mortaise BDF.' },
  { id: 'frame', icon: 'frame', k: 'Huisserie', title: 'Cadre soudé 4 côtés', text: 'Huisserie en tôle multiplis 20/10e électrozinguée, anti-pince, en version rénovation ou tubulaire pour le neuf.' },
  { id: 'seals', icon: 'flame', k: 'Coupe-feu', title: 'Joints intumescents', text: 'Sur les modèles coupe-feu, les joints gonflent sous la chaleur et bloquent flammes et fumées (EI2 30 à 60 min certifié EFECTIS).' },
];
---

<section class="anatomy section" data-anatomy aria-labelledby="anatomy-title" style={`--n:${steps.length}`}>
  <div class="container--wide anatomy__grid">
    <header class="anatomy__head">
      <p class="eyebrow" data-reveal>Anatomie d'une porte blindée</p>
      <h2 id="anatomy-title" class="h2" data-reveal style="--d:.1s">Une conception <span class="grad-accent">sans compromis</span></h2>
      <p class="lead" data-reveal style="--d:.2s">Faites défiler pour démonter couche par couche une porte blindée BDF, conçue et fabriquée dans notre usine d'Aulnay-sous-Bois.</p>
    </header>

    <div class="anatomy__stage" data-anatomy-track>
      <div class="anatomy__sticky">
        <div class="anatomy__view">
          <canvas class="anatomy__canvas" data-anatomy-canvas aria-label="Vue éclatée 3D d'une porte blindée" role="img"></canvas>
          <div class="anatomy__fallback" data-anatomy-fallback hidden>
            <img src="/media/fiches-produits/signature-1v.png" alt="Porte blindée SIGNATURE" loading="lazy" />
          </div>
          <div class="anatomy__hud mono" aria-hidden="true">
            <span>VUE ÉCLATÉE · SIGNATURE BP1</span>
            <span data-anatomy-label>{steps[0].k}</span>
          </div>
          <div class="anatomy__ctrl">
            <button type="button" class="chip" data-anatomy-toggle aria-pressed="false"><Icon name="layers" size={16} /> Éclater / assembler</button>
          </div>
        </div>

        <!-- Version mobile : fiche de la couche affichée sous la porte -->
        <div class="adeck" data-adeck aria-hidden="true">
          <div class="adeck__bar">
            {[{ k: 'Vue d’ensemble' }, ...steps].map((_, i) => <span class="adeck__seg" data-adeck-seg={i}><i></i></span>)}
          </div>
          <div class="adeck__row">
            <p class="adeck__k mono" data-adeck-k>Vue d’ensemble</p>
            <div class="adeck__nav">
              <button type="button" tabindex="-1" data-adeck-prev aria-label="Couche précédente"><Icon name="chevron-left" size={18} /></button>
              <span class="mono" data-adeck-count>00 / {String(steps.length).padStart(2, '0')}</span>
              <button type="button" tabindex="-1" data-adeck-next aria-label="Couche suivante"><Icon name="chevron-right" size={18} /></button>
            </div>
          </div>
          <div class="adeck__cards">
            <article class="adeck__card is-active" data-adeck-card="0">
              <span class="icon-box"><Icon name="door-closed" /></span>
              <div>
                <h3 class="adeck__t">Porte assemblée</h3>
                <p>Faites défiler : la porte se démonte couche par couche, de la tôle d’acier jusqu’aux joints coupe-feu.</p>
              </div>
            </article>
            {
              steps.map((s, i) => (
                <article class="adeck__card" data-adeck-card={i + 1}>
                  <span class="icon-box">
                    <Icon name={s.icon} />
                  </span>
                  <div>
                    <h3 class="adeck__t">{s.title}</h3>
                    <p>{s.text}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <ol class="asteps">
      {
        steps.map((s, i) => (
          <li class="astep" data-astep={s.id} data-k={s.k}>
            <div class="astep__num mono">{String(i + 1).padStart(2, '0')}</div>
            <div class="astep__body panel">
              <span class="icon-box">
                <Icon name={s.icon} />
              </span>
              <p class="astep__k mono">{s.k}</p>
              <h3 class="h3">{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="anatomy__cta">
      <a href="/catalogue/blocs-portes-certifies/signature-bp1-1-vantail" class="btn">Voir la SIGNATURE <Icon name="arrow-right" /></a>
      <a href="/configurateur" class="btn btn--ghost"><Icon name="cube" /> Configurer ma porte</a>
    </div>
  </div>
</section>

<style>
  /* ------------------------------------------------ ordinateur : scène à gauche, étapes à droite */
  .anatomy__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    grid-template-areas:
      'stage head'
      'stage list'
      'stage cta';
    grid-template-rows: auto 1fr auto;
    column-gap: clamp(1.5rem, 4vw, 5rem);
  }
  .anatomy__head {
    grid-area: head;
    display: grid;
    gap: 1rem;
    padding-top: 2rem;
    margin-bottom: 3rem;
  }
  .anatomy__stage {
    grid-area: stage;
    position: relative;
  }
  .anatomy__sticky {
    position: sticky;
    top: calc(var(--header-h) + 1rem);
    height: calc(100vh - var(--header-h) - 2rem);
    height: calc(100svh - var(--header-h) - 2rem);
    border-radius: 22px;
    overflow: hidden;
    background:
      radial-gradient(60% 50% at 50% 55%, rgba(46, 104, 148, 0.28), transparent 70%),
      linear-gradient(180deg, rgba(10, 25, 41, 0.6), rgba(3, 7, 14, 0.6));
    border: 1px solid var(--line);
  }
  .anatomy__view {
    position: absolute;
    inset: 0;
  }
  .anatomy__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .anatomy__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 3rem;
  }
  .anatomy__fallback img {
    max-height: 100%;
    width: auto;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.5));
  }
  .anatomy__hud {
    position: absolute;
    top: 1.2rem;
    left: 1.4rem;
    right: 1.4rem;
    display: flex;
    justify-content: space-between;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: var(--muted);
    pointer-events: none;
  }
  .anatomy__hud span:last-child {
    color: var(--accent);
  }
  .anatomy__ctrl {
    position: absolute;
    left: 1.2rem;
    bottom: 1.2rem;
  }
  .adeck {
    display: none;
  }
  .asteps {
    grid-area: list;
    list-style: none;
    display: grid;
  }
  .astep {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1rem;
    min-height: 58vh;
    align-items: center;
    opacity: 0.32;
    transition: opacity 0.5s var(--ease);
  }
  .astep.is-active {
    opacity: 1;
  }
  .astep__num {
    align-self: center;
    font-size: 1.4rem;
    color: var(--dim);
    transition: color 0.4s;
  }
  .astep.is-active .astep__num {
    color: var(--accent);
  }
  .astep__body {
    display: grid;
    gap: 0.6rem;
    padding: 1.6rem;
    transition:
      border-color 0.4s,
      transform 0.6s var(--ease);
  }
  .astep.is-active .astep__body {
    border-color: rgba(74, 115, 150, 0.68);
    transform: translateX(-6px);
  }
  .astep__body p {
    margin: 0;
    color: var(--text-2);
  }
  .astep__k {
    font-size: 0.66rem !important;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent) !important;
  }
  .anatomy__cta {
    grid-area: cta;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    padding: 2rem 0 0 72px;
  }

  /* ------------------------------------------------ tablette & mobile : scène épinglée plein écran */
  @media (max-width: 960px) {
    .anatomy {
      padding-bottom: calc(var(--section) * 0.6);
    }
    .anatomy__grid {
      display: block;
    }
    .anatomy__head {
      padding-top: 0;
      margin-bottom: 1.5rem;
    }
    /* piste de défilement : une « page » par couche */
    .anatomy__stage {
      height: calc((var(--n) + 1) * 58svh + 100svh);
      margin-inline: calc(-1 * var(--gutter));
    }
    .anatomy__sticky {
      top: 0;
      height: 100vh;
      height: 100svh;
      display: flex;
      flex-direction: column;
      padding-bottom: calc(74px + env(safe-area-inset-bottom));
      border: 0;
      border-radius: 0;
      background:
        radial-gradient(90% 55% at 50% 42%, rgba(46, 104, 148, 0.34), transparent 70%),
        linear-gradient(180deg, #03070e 0%, #0a1929 55%, #03070e 100%);
    }
    .anatomy__view {
      position: relative;
      inset: auto;
      flex: 1 1 auto;
      min-height: 0;
    }
    .anatomy__hud {
      top: calc(var(--header-h) + 0.6rem);
      left: var(--gutter);
      right: var(--gutter);
      font-size: 0.6rem;
    }
    .anatomy__hud span:last-child {
      display: none;
    }
    .anatomy__ctrl {
      display: none;
    }
    /* la liste reste lisible par les lecteurs d'écran */
    .asteps {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .anatomy__cta {
      padding: 1.5rem 0 0;
    }
    .anatomy__cta .btn {
      flex: 1 1 100%;
    }

    .adeck {
      position: relative;
      z-index: 2;
      display: grid;
      gap: 0.75rem;
      margin: 0 var(--gutter);
      padding: 1rem 1.1rem 1.15rem;
      background: linear-gradient(180deg, rgba(10, 25, 41, 0.96), rgba(3, 10, 20, 0.97));
      border: 1px solid rgba(74, 115, 150, 0.45);
      border-radius: 18px;
      box-shadow:
        0 -20px 60px rgba(3, 7, 14, 0.7),
        0 0 0 1px rgba(255, 255, 255, 0.02) inset;
    }
    .adeck::before {
      content: '';
      position: absolute;
      top: -1px;
      left: 18px;
      right: 18px;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--accent), transparent);
      opacity: 0.8;
    }
    .adeck__bar {
      display: flex;
      gap: 4px;
    }
    .adeck__seg {
      flex: 1;
      height: 3px;
      border-radius: 3px;
      background: rgba(74, 115, 150, 0.22);
      overflow: hidden;
    }
    .adeck__seg i {
      display: block;
      height: 100%;
      width: 0;
      background: var(--accent);
      box-shadow: 0 0 10px var(--accent-glow);
    }
    .adeck__seg.is-done i {
      width: 100%;
    }
    .adeck__seg.is-on i {
      width: var(--sp, 0%);
    }
    .adeck__row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .adeck__k {
      margin: 0;
      font-size: 0.66rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-2);
    }
    .adeck__nav {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.7rem;
      color: var(--muted);
    }
    .adeck__nav button {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      color: #fff;
      border: 1px solid rgba(74, 115, 150, 0.5);
      background: rgba(74, 115, 150, 0.12);
      transition:
        background 0.2s,
        opacity 0.2s;
    }
    .adeck__nav button:active {
      background: rgba(74, 115, 150, 0.35);
    }
    .adeck__nav button:disabled {
      opacity: 0.3;
    }
    .adeck__cards {
      display: grid;
    }
    .adeck__card {
      grid-area: 1 / 1;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.9rem;
      align-items: start;
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.45s var(--ease),
        transform 0.55s var(--ease);
      pointer-events: none;
    }
    .adeck__card.is-before {
      transform: translateY(-14px);
    }
    .adeck__card.is-active {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    .adeck__card .icon-box {
      margin-top: 2px;
    }
    .adeck__t {
      margin: 0 0 0.35rem;
      font-family: var(--f-display);
      font-size: 1rem;
      font-weight: 400;
      line-height: 1.25;
      text-transform: uppercase;
      color: #fff;
    }
    .adeck__card p {
      margin: 0;
      font-size: 0.88rem;
      line-height: 1.55;
      color: var(--text-2);
    }
  }
  /* tablette : les boutons d'action flottent à droite */
  @media (min-width: 761px) and (max-width: 960px) {
    .anatomy__sticky {
      padding-bottom: 1.2rem;
    }
    .adeck {
      margin-right: calc(var(--gutter) + 64px);
    }
  }
  /* téléphone à l'horizontale : porte à gauche, fiche à droite */
  @media (max-width: 960px) and (orientation: landscape) and (max-height: 560px) {
    .anatomy__sticky {
      flex-direction: row;
      align-items: center;
      padding-bottom: 0;
    }
    .anatomy__view {
      align-self: stretch;
    }
    .adeck {
      flex: 0 0 46%;
      margin: 0 calc(var(--gutter) + 64px) 0 0;
    }
  }
  @media (max-width: 960px) and (max-height: 700px) {
    .adeck__card p {
      font-size: 0.82rem;
      line-height: 1.45;
    }
    .adeck {
      gap: 0.55rem;
      padding: 0.85rem 1rem 0.95rem;
    }
  }
</style>
