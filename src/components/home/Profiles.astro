---
import Icon from '@/components/Icon.astro';
---

<section class="section profiles" aria-label="Particuliers et professionnels">
  <div class="container">
    <div class="profiles__grid">
      <div data-reveal="tilt"><article class="pcard panel spot" data-tilt="6" data-spot>
        <div class="pcard__glare" aria-hidden="true"></div>
        <div class="pcard__top">
          <span class="icon-box"><Icon name="home" /></span>
          <span class="eyebrow">Pour particuliers &amp; entreprises</span>
        </div>
        <h2 class="h2">Je cherche une porte blindée</h2>
        <p class="muted">Découvrez nos solutions de sécurité certifiées et trouvez un installateur agréé près de chez vous.</p>
        <ul class="pcard__list">
          <li><a href="/catalogue"><Icon name="grid" /> Consulter le catalogue produits <Icon name="arrow-right" class="pcard__go" /></a></li>
          <li><a href="/certification-porte-blindee"><Icon name="badge-check" /> Comparer les certifications <Icon name="arrow-right" class="pcard__go" /></a></li>
          <li><a href="/installateurs-portes-blindees"><Icon name="map-pin" /> Trouver un installateur certifié <Icon name="arrow-right" class="pcard__go" /></a></li>
        </ul>
        <a href="/catalogue" class="btn">Voir le catalogue <Icon name="arrow-right" /></a>
        <span class="pcard__num" aria-hidden="true">01</span>
      </article></div>

      <div data-reveal="tilt" style="--d:.15s"><article class="pcard pcard--pro panel spot" data-tilt="6" data-spot>
        <div class="pcard__glare" aria-hidden="true"></div>
        <div class="pcard__top">
          <span class="icon-box icon-box--steel"><Icon name="briefcase" /></span>
          <span class="eyebrow">Pour installateurs professionnels</span>
        </div>
        <h2 class="h2">Je suis installateur professionnel</h2>
        <p class="muted">Rejoignez notre réseau de partenaires certifiés et bénéficiez de tous nos avantages pros.</p>
        <ul class="pcard__list">
          <li><a href="/rejoindre-le-reseau-dinstallateurs-bdf"><Icon name="users" /> Devenir installateur agréé BDF <Icon name="arrow-right" class="pcard__go" /></a></li>
          <li><a href="/espace-pro"><Icon name="file-text" /> Accéder aux tarifs professionnels <Icon name="arrow-right" class="pcard__go" /></a></li>
          <li><a href="/nous-contacter"><Icon name="wrench" /> Formation et support technique <Icon name="arrow-right" class="pcard__go" /></a></li>
        </ul>
        <a href="/rejoindre-le-reseau-dinstallateurs-bdf" class="btn btn--steel">Nous rejoindre <Icon name="arrow-right" /></a>
        <span class="pcard__num" aria-hidden="true">02</span>
      </article></div>
    </div>
  </div>
</section>

<style>
  .profiles {
    padding-top: calc(var(--section) * 0.7);
  }
  .profiles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 1.5rem;
    perspective: 1400px;
  }
  .profiles__grid > div {
    display: grid;
  }
  .pcard {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1.1rem;
    padding: clamp(1.6rem, 1rem + 2vw, 2.8rem);
    overflow: hidden;
    transform: perspective(1200px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease), border-color 0.4s;
    background:
      radial-gradient(80% 60% at 100% 0%, rgba(255, 102, 34, 0.14), transparent 60%),
      linear-gradient(160deg, rgba(20, 44, 74, 0.6), rgba(6, 16, 30, 0.8));
  }
  .pcard--pro {
    background:
      radial-gradient(80% 60% at 100% 0%, rgba(46, 104, 148, 0.35), transparent 60%),
      linear-gradient(160deg, rgba(20, 44, 74, 0.6), rgba(6, 16, 30, 0.8));
  }
  :global(.pcard.is-tilting) {
    transition: border-color 0.4s;
  }
  .pcard:hover {
    border-color: rgba(255, 102, 34, 0.45);
  }
  .pcard__glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(600px circle at var(--gx, 50%) var(--gy, 0%), rgba(255, 255, 255, 0.08), transparent 40%);
  }
  .pcard__top {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .pcard .h2 {
    font-size: var(--fs-xl);
    transform: translateZ(40px);
  }
  .pcard p {
    margin: 0;
    max-width: 48ch;
  }
  .pcard__list {
    list-style: none;
    display: grid;
    gap: 0.2rem;
    margin: 0.4rem 0 0.8rem;
    transform: translateZ(25px);
  }
  .pcard__list a {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 0.2rem;
    border-bottom: 1px solid var(--line);
    color: var(--text-2);
    transition: color 0.2s, padding 0.3s var(--ease);
  }
  .pcard__list a :global(svg:first-child) {
    color: var(--orange);
  }
  .pcard__list a:hover {
    color: #fff;
    padding-left: 0.6rem;
  }
  :global(.pcard__go) {
    margin-left: auto;
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.3s var(--ease);
  }
  .pcard__list a:hover :global(.pcard__go) {
    opacity: 1;
    transform: none;
  }
  .pcard .btn {
    justify-self: start;
    transform: translateZ(50px);
  }
  .pcard__num {
    position: absolute;
    right: 1.4rem;
    bottom: 0.4rem;
    font-family: var(--f-display);
    font-size: clamp(4rem, 3rem + 4vw, 7.5rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(148, 178, 212, 0.14);
    pointer-events: none;
  }
</style>
