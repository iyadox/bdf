---
import Icon from '@/components/Icon.astro';
import { formatDate } from '@/lib/site';
interface Props {
  id: string;
  title: string;
  date: Date;
  category: string;
  excerpt?: string;
  cover?: string;
  video?: string;
}
const { id, title, date, category, excerpt, cover, video } = Astro.props;
const img = cover || (video ? `/media/video-thumbnails/${video}.jpg` : '/media/qui-sommes-nous/facade-bdf.jpg');
---

<a href={`/news-focus/${id}`} class="ncard panel" data-spot>
  <div class="ncard__img">
    <img src={img} alt="" loading="lazy" width="640" height="360" />
    {video && <span class="ncard__play"><Icon name="play" size={16} /></span>}
  </div>
  <div class="ncard__body">
    <p class="ncard__meta mono"><span>{category}</span><time datetime={date.toISOString()}>{formatDate(date)}</time></p>
    <h3 class="ncard__title">{title}</h3>
    {excerpt && <p class="ncard__ex truncate-3">{excerpt}</p>}
    <span class="link-arrow">Lire l'article <Icon name="arrow-right" /></span>
  </div>
</a>

<style>
  .ncard {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
    transition: border-color 0.3s, transform 0.5s var(--ease);
  }
  .ncard:hover {
    border-color: rgba(74, 115, 150, 0.68);
    transform: translateY(-4px);
  }
  .ncard__img {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0a1929;
  }
  .ncard__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .ncard:hover .ncard__img img {
    transform: scale(1.05);
  }
  .ncard__play {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
  }
  .ncard__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.3rem 1.4rem 1.5rem;
    flex: 1;
  }
  .ncard__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ncard__meta span {
    color: var(--accent);
  }
  .ncard__title {
    font-size: 1.08rem;
    font-weight: 650;
    line-height: 1.35;
  }
  .ncard__ex {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-2);
  }
  .ncard .link-arrow {
    margin-top: auto;
  }
</style>
